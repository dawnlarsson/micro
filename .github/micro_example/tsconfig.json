{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "micro",
        "module": "esnext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "micro/jsx-runtime": [
                "../../jsx-runtime.ts"
            ]
        },
        "noEmit": true
    },
    "include": [
        "micro.d.ts",
        "components/**/*.tsx"
    ]
}